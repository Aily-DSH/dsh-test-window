{
  "name": "dsh-test-window",
  "version": "0.1.2",
  "description": "Pick the display that test windows open on: a dsh settings page chooses a monitor, and both that page and the open_test_window agent tool move the spawned window onto it",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2"
  },
  "license": "MIT",
  "author": "Aily-DSH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aily-DSH/dsh-test-window.git"
  },
  "homepage": "https://github.com/Aily-DSH/dsh-test-window#readme",
  "bugs": {
    "url": "https://github.com/Aily-DSH/dsh-test-window/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "windows",
    "multi-monitor",
    "window-placement"
  ]
}
